# AUTOMATION AND CURSOR
.cursor/**

# MISCELLANEOUS AND ORGANIZATION
# Data files (uncomment specific lines to track them)
*.csv
*.dta
*.xlsx
.DS_Store

renv/**

.env
# Ignore .claude contents (settings.local.json, etc.) but version the pieces
# that are project infrastructure so they travel with the repo across
# sessions/machines: rebuild plans, the shared hook config, and the skills.
.claude/*
!.claude/plans/
!.claude/settings.json
!.claude/skills/

# DATA
