# AUTOMATION AND CURSOR
.cursor/**

# MISCELLANEOUS AND ORGANIZATION
# Data files (uncomment specific lines to track them)
*.csv
*.dta
*.xlsx
.DS_Store

renv/**

.env
# Ignore .claude contents (settings.local.json, etc.) but version the pieces
# that are project infrastructure so they travel with the repo across
# sessions/machines: rebuild plans, the shared hook config, and the skills.
.claude/*
!.claude/plans/
!.claude/settings.json
!.claude/skills/

# DATA
# SNAP ABAWD WAIVERS
1_data/10_raw/100_usda/1000_abawd_waivers/FY**/**.pdf
1_data/10_raw/100_usda/1001_abawd_openai_responses/**/*.json
# Archives of prior OpenAI response folders (zip from 2210_extract_abawd_waivers.py)
1_data/10_raw/100_usda/archives/*.zip
# FNA rebuild corpus: regenerable from the scraper + manifest, so kept out of git
# (see verification: pipeline must rebuild from a clean checkout with the corpus absent).
1_data/10_raw/102_fna/1020_timelimit_waiver_docs/**/*.pdf
1_data/10_raw/102_fna/1020_timelimit_waiver_docs/**/*.doc
1_data/10_raw/102_fna/1020_timelimit_waiver_docs/**/*.docx
# FNA application ("State Requests and Data") zips + everything extracted from them.
1_data/10_raw/102_fna/1023_application_docs/
# FNA extraction outputs. Originally ignored as "regenerable", but the NC run-1 vs
# run-2 replication (2026-08-10) showed agentic extraction is NOT deterministic:
# independent runs of the same prompt/schema/model differ on transcription (Pasguotank
# -> Pasquotank) and on judgment calls (FY2013 criterion null vs eb_trigger). Prompt
# revisions can only be evaluated against a FIXED baseline, so the model JSONs are
# versioned. The derived flat/comparison CSVs stay ignored -- those ARE deterministic
# given the JSONs.
!1_data/10_raw/102_fna/1022_extractions/**/*.json
1_data/10_raw/102_fna/1022_extractions/*.csv

# GEO REFERENCE (state geography context build)
# Raw Census/BLS reference pulls: regenerable via make geo_fetch.
1_data/10_raw/103_geo/
# Hand-curated county-change log: versioned source input (overrides blanket *.csv).
!0_lit/01_geo/010_county_changes_1997_present.csv

# SCRIPTS
# Helper scripts and cache
2_scripts/22_extract/221_abawd_waivers/__pycache__/
2_scripts/22_extract/222_fna_waivers/__pycache__/

# WORKLOG (session research record) -- track the CSV database
# (overriding any global *.csv ignore). Entries are .md and track
# by default; session-id state lives globally, not in the repo.
!.worklog/worklog.csv
