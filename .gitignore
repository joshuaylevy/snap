# AUTOMATION AND CURSOR
.cursor/**

# MISCELLANEOUS AND ORGANIZATION
# Data files (uncomment specific lines to track them)
*.csv
*.dta
*.xlsx
.DS_Store

renv/**

.env
# Ignore .claude contents (settings.local.json, etc.) but version the plans so
# rebuild plans travel with the repo across sessions/machines.
.claude/*
!.claude/plans/

