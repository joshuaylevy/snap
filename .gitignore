1_data/10_raw/100_usda/1001_abawd_openai_responses/**/*.json
# Archives of prior OpenAI response folders (zip from 2210_extract_abawd_waivers.py)
1_data/10_raw/100_usda/archives/*.zip
# FNA rebuild corpus: regenerable from the scraper + manifest, so kept out of git
